# AgentDesk 4-API-Key Round-Robin Pool (Optional Secrets Fallback)
# You can enter all 4 Gemini API keys directly inside the app's Keys & Models screen,
# or pre-configure them via the AI Studio Secrets panel using these 4 variables.
# For independent RPM/TPM/RPD rate limits, each key should belong to a separate Google Cloud project.
GEMINI_API_KEY_1=UNSET
GEMINI_API_KEY_2=UNSET
GEMINI_API_KEY_3=UNSET
GEMINI_API_KEY_4=UNSET
